{
  "name": "coding-dojo",
  "version": "0.1.0",
  "description": "A personal, AI-tutored training dojo for software engineers. System design, AI engineering, DSA and more, run from Claude Code.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dojo": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node --disable-warning=ExperimentalWarning src/cli.ts validate --solutions",
    "check": "npm run typecheck && npm test && npm run validate"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
